# Copy to .env.local and fill in. Never commit .env.local.
# Leave the Supabase lines empty to run on fake in-memory demo data (no login).

# Supabase → Project Settings → API (URL + publishable key, or legacy anon key)
NEXT_PUBLIC_SUPABASE_URL=https://dkshljthydrznpylekzm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google AI Studio → Get API key (server only, never NEXT_PUBLIC_)
GEMINI_API_KEY=
# Model ID exactly as AI Studio's "Get code" shows it. If it's wrong, nari falls back to gemini-flash-latest.
GEMINI_MODEL=
# Optional: comma-separated backups tried when the main model is busy/out of quota
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest

# Judge demo account for the "try the demo" button
DEMO_EMAIL=
DEMO_PASSWORD=

# ElevenLabs text-to-speech (server only) for the listen button
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Model ID from the ElevenLabs dashboard. Default: eleven_flash_v2_5
ELEVENLABS_MODEL=
